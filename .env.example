# 复制为 .env 后按需修改(dev 默认值与 docker-compose.dev.yaml 一致,通常无需改动)
ETL_ENV=dev
ETL_LOG_LEVEL=INFO
ETL_LOG_FORMAT=console

ETL_DB_HOST=localhost
# dev 下宿主机 3306 被本机 MySQL 占用,compose 映射到 13306
ETL_DB_PORT=13306
ETL_DB_USER=etl
ETL_DB_PASSWORD=etl_pass

ETL_PLATFORM_NAME=mock
ETL_PLATFORM_BASE_URL=http://localhost:8080
ETL_PLATFORM_CLIENT_ID=test_client
ETL_PLATFORM_CLIENT_SECRET=test_secret

# 抽取容错(M3): 死信率上限(0 表示永不中止)、装载后 DQ 开关
ETL_EXTRACTION_DEAD_LETTER_LIMIT=0.01
ETL_EXTRACTION_DQ_ENABLED=true

# 告警(M3): 全部通道留空时自动兜底为日志通道(dev 无需配置);
# 生产配置任一通道即启用,见 docs/architecture.md
ETL_ALERT_ENABLED=true
ETL_ALERT_MIN_LEVEL=warning
ETL_ALERT_DINGTALK_WEBHOOK=
ETL_ALERT_DINGTALK_SECRET=
ETL_ALERT_WECOM_WEBHOOK=
ETL_ALERT_SMTP_HOST=
ETL_ALERT_SMTP_PORT=465
ETL_ALERT_SMTP_USER=
ETL_ALERT_SMTP_PASSWORD=
ETL_ALERT_SMTP_FROM=
ETL_ALERT_SMTP_TO=

MOCK_API_ORDERS_PER_DAY=500
MOCK_API_TOKEN_TTL_SECONDS=7200
