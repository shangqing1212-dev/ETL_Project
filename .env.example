# 复制为 .env 后按需修改(dev 默认值与 docker-compose.dev.yaml 一致,通常无需改动)
ETL_ENV=dev
ETL_LOG_LEVEL=INFO
ETL_LOG_FORMAT=console

ETL_DB_HOST=localhost
# dev 下宿主机 3306 被本机 MySQL 占用,compose 映射到 13306
ETL_DB_PORT=13306
ETL_DB_USER=etl
ETL_DB_PASSWORD=etl_pass

ETL_PLATFORM_NAME=mock
ETL_PLATFORM_BASE_URL=http://localhost:8080
ETL_PLATFORM_CLIENT_ID=test_client
ETL_PLATFORM_CLIENT_SECRET=test_secret

MOCK_API_ORDERS_PER_DAY=500
MOCK_API_TOKEN_TTL_SECONDS=7200
