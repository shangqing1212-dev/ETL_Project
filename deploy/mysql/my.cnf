# 生产 MySQL 配置(挂载到 /etc/mysql/conf.d/;dev 容器用命令行参数近似,见 airflow/docker-compose.dev.yaml)
# 要点: utf8mb4 默认、+08:00 时区(ADR-001)、binlog 开启(PITR 前提)、慢查询记录。
# 注意: 生产凭据走独立运维流程,不用 dev 的 MYSQL_ROOT_PASSWORD 方式。

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+08:00'

# ---- binlog(PITR 前提,备份策略见 docs/runbook.md 第 4 节)----
log_bin = /var/lib/mysql/mysql-bin
binlog_format = ROW
binlog_expire_logs_seconds = 604800  # binlog 保留 7 天(覆盖周备周期)
max_binlog_size = 512M
sync_binlog = 1                       # 生产安全优先(性能换一致性)

# ---- 慢查询 ----
slow_query_log = ON
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = OFF   # 日志噪声控制,需要时打开

# ---- 资源(按服务器规格调整,百万行/天单机够用)----
innodb_buffer_pool_size = 2G
max_connections = 200
